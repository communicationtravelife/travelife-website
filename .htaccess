# Redirections 301 : anciennes adresses WordPress -> nouvelles pages (préserve le référencement)
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Forcer https et sans www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://travelife.ma/$1 [R=301,L]

# /page/index.html -> /page/ (une seule adresse par page)
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.html[\s?] [NC]
RewriteRule ^(.*?)index\.html$ /$1 [R=301,L,NC]

# Ajouter le / final (/articles -> /articles/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# Adresses connues de l'ancien site
RewriteRule ^tarifs/$ /tarifs-logiciel-travelife/ [R=301,L]
RewriteRule ^contact/$ /contactez/ [R=301,L]
RewriteRule ^site\-internet\-pour\-agence\-de\-voyage/$ /site-internet-pour-agence-de-voyages/ [R=301,L]
RewriteRule ^oumaima/oumaima/$ /a-propos/ [R=301,L]
RewriteRule ^index\.php/manage/$ /manage-travelife/ [R=301,L]
RewriteRule ^index\.php/tarifs/$ /tarifs-logiciel-travelife/ [R=301,L]
RewriteRule ^index\.php/tarifs$ /tarifs-logiciel-travelife/ [R=301,L]
RewriteRule ^index\.php/contact/$ /contactez/ [R=301,L]
RewriteRule ^index\.php/site\-internet\-pour\-agence\-de\-voyage/$ /site-internet-pour-agence-de-voyages/ [R=301,L]

# index.php/page/ -> /page/ (anciennes adresses WordPress)
RewriteRule ^index\.php/(.+)$ /$1 [R=301,L]

# Pagination, flux RSS et archives par date de WordPress
RewriteRule ^articles/page/[0-9]+/?$ /articles/ [R=301,L]
RewriteRule ^category/([^/]+)/page/[0-9]+/?$ /category/$1/ [R=301,L]
RewriteRule ^page/[0-9]+/?$ / [R=301,L]
RewriteRule ^feed/?$ /articles/ [R=301,L]
RewriteRule ^category/([^/]+)/feed/?$ /category/$1/ [R=301,L]
RewriteRule ^([^/]+)/feed/?$ /$1/ [R=301,L]
RewriteRule ^(19|20)[0-9]{2}(/[0-9]{2}){0,2}/?$ / [R=301,L]
RewriteRule ^author/ /a-propos/ [R=301,L]
RewriteRule ^(wp-admin|wp-login\.php) / [R=301,L]

# Anciennes images redimensionnées (photo-300x200.jpg -> photo.jpg)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/wp-content/uploads/$1$2 -f
RewriteRule ^wp-content/uploads/(.+)-[0-9]+x[0-9]+(\.[a-zA-Z]+)$ /wp-content/uploads/$1$2 [R=301,L]

# Étiquettes (tags) -> article ou catégorie correspondante
RewriteRule ^tag/2024/?$ /category/nouveaute/ [R=301,L]
RewriteRule ^tag/2025/?$ /category/tourisme/ [R=301,L]
